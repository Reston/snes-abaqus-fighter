  "supplemental_harness_source": "\"\"\"Self-contained supplemental proof; exact source is embedded in its JSON.\"\"\"\nfrom pathlib import Path\nimport hashlib\nimport io\nimport json\nimport subprocess\nimport sys\nimport zipfile\n\nROOT = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(ROOT/'tools'))\nimport test_audio as audio\nimport test_champion_audio as focused\nfrom test_champion import host_contract\n\n\ndef require(condition, label):\n    if not condition:\n        raise ValueError(label)\n\n\nfirst = json.loads((ROOT/'docs/champion-audio-report.json').read_text())\nmanifest = json.loads((ROOT/'dist/manifest.json').read_text())\nrom = (ROOT/'dist/abaqus-after-hours.sfc').read_bytes()\nrequire(first['status'] == 'passed', 'focused capture run must pass first')\nrequire(first['rom_sha256'] == manifest['sha256'] == audio.digest(rom), 'second asset build must reproduce tested ROM')\nrequire(first['checksum'] == manifest['checksum'] == 'AA1A', 'checksum must reproduce')\nhost = host_contract()\nrequire(host['priority_class'] == 0x4000 and host['logical_processors'] == [14, 15], 'background host contract')\nproof = focused.preservation()\narchive = focused.command(['git', 'archive', '--format=zip', focused.BASE, 'assets/generated/soundbank.bnk'])\nwith zipfile.ZipFile(io.BytesIO(archive)) as package:\n    old = package.read('assets/generated/soundbank.bnk')\nnew = (ROOT/'assets/generated/soundbank.bnk').read_bytes()\nsources = int.from_bytes(old[:2], 'little')\nrequire(sources == int.from_bytes(new[:2], 'little') == 15, 'BRR source count remains fifteen')\nnative_sources = []\nfor index in range(sources):\n    before, after = focused.bank_sample(old, index), focused.bank_sample(new, index)\n    require(before == after, 'every original native BRR source remains exact')\n    native_sources.append({'source_index': index, 'header_and_brr_sha256': audio.digest(after)})\nrequire(audio.digest((ROOT/'assets/generated/music4.it').read_bytes()) ==\n        first['music']['office-champion']['module_sha256'], 'second build reproduces victory IT')\nfor name, cue in first['victory_cue_fixture']['cues'].items():\n    require(cue['mixed_pcm']['longest_near_silence_seconds'] < 0.5, name+' under victory has no long dropout')\n\ne = audio.Emulator()\ntry:\n    e.run(180)\n    audio.press(e, 'up')  # Native title: Arcade -> Training.\n    audio.press(e, 'a'); audio.wait(e, 1)\n    audio.press(e, 'left')  # P1 chooses fighter 11.\n    audio.press(e, 'a')\n    audio.press(e, 'right', 1); audio.press(e, 'right', 1)\n    audio.press(e, 'a', 1); audio.wait(e, 2)  # Pad 2 chooses dummy fighter 2.\n    audio.press(e, 'a'); audio.wait(e, 3); e.run(180)\n    selected = e.state()\n    require((selected['mode'], selected['fighter_id1'], selected['fighter_id2']) == (2, 11, 2),\n            'combined Training opponent selection remains controller-accessible')\n    e.tap('select'); e.run(12)\n    reset = e.state()\n    require((reset['mode'], reset['fighter_id1'], reset['fighter_id2'], reset['hp1'], reset['hp2']) ==\n            (2, 11, 2, 128, 128), 'Training reset retains the independently chosen fighter identities')\nfinally:\n    e.close()\n\nreport = {'status': 'passed', 'scope': 'second deterministic local asset build, exact native preservation and bounded Training smoke',\n          'rom_sha256': manifest['sha256'], 'checksum': manifest['checksum'], 'rom_bytes': len(rom),\n          'asset_build_command': '.tools/python/python.exe tools/build.py --assets (run twice in child)',\n          'isolated_source_rebuild': False, 'host_contract': host,\n          'headless': True, 'audio_device_opened': False, 'emulated_memory_writes': 0, 'savestates': 0,\n          'preservation': proof, 'all_fifteen_native_brr_sources': native_sources,\n          'training_controller_smoke': {'selected': selected, 'after_select_reset': reset},\n          'supplemental_harness_source': Path(__file__).read_text()}\n(ROOT/'docs/champion-audio-rebuild-report.json').write_text(json.dumps(report, indent=2)+'\\n', encoding='utf-8')\nprint(json.dumps({'status': report['status'], 'rom_sha256': report['rom_sha256']}))\n"
}
